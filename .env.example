# ═══════════════ ZEUS-MD CONFIGURATION ═══════════════
# Copy to .env on your panel:  cp .env.example .env
# (On Pterodactyl you can also set these as environment variables in Startup/Environment tab)

# ─── Bot ───
BOT_NAME=ZEUS-MD

# Owner name (shown in menu / info / owner command)
OWNER_NAME=ZEUS

# Owner WhatsApp number — INTERNATIONAL format, digits ONLY, no +, no spaces.
# Example: 09066760078 (Nigeria) → 2349066760078
OWNER_NUMBER=2349066760078

# ─── Premium ───
PREMIUM_CODE=200709

# ─── Chatbot (Groq AI) ───
# Display name of the chatbot
CHATBOT_NAME=ZARA
# Groq API key from https://console.groq.com — leave EMPTY to disable the chatbot
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Commands ───
# Command prefix (must be a single character)
PREFIX=.
# HTTP health-check port (keep-alive for Render/Railway/Koyeb/Pterodactyl)
PORT=2091
# Hot reload commands during development (true/false — set false in production to save CPU)
HOT_RELOAD=true

# ─── ZEUS TIER'S WhatsApp Channel (bot auto-joins after pairing) ───
CHANNEL_LINK=https://whatsapp.com/channel/0029VabYlvq6xCSKAxKpKB1m
CHANNEL_INVITE_CODE=0029VabYlvq6xCSKAxKpKB1m

# ─── FIRST-RUN PAIRING ───
# Your WhatsApp number (international format, digits only, e.g. 2349066760078).
#
#   • Pterodactyl / VPS / Termux / Windows (hosts WITH a console):
#       leave PHONE_NUMBER EMPTY → the bot will ASK you for the number in the
#       console and then print the PAIRING CODE.
#
#   • Render / Railway / Koyeb (hosts WITHOUT a console):
#       SET PHONE_NUMBER here → the bot skips the prompt and requests the code
#       automatically.
PHONE_NUMBER=
